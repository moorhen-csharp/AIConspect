<Window x:Class="AIConspect.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:viewmodels="clr-namespace:AIConspect.ViewModels"
        xmlns:models="clr-namespace:AIConspect.Models"
        Title="AI-Конспект"
        Height="750" Width="1100"
        MinHeight="600" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        TextElement.FontFamily="{DynamicResource MaterialDesignFont}">

    <Window.DataContext>
        <viewmodels:MainViewModel/>
    </Window.DataContext>

    <Grid>
        <!-- ════════════════════════════════════════════
             ЭКРАН ВЫБОРА ПРОФИЛЯ
             ════════════════════════════════════════════ -->
        <Grid Visibility="{Binding IsProfileSelectionVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Шапка -->
            <materialDesign:ColorZone Mode="PrimaryMid" Padding="24,20" Grid.Row="0">
                <StackPanel>
                    <TextBlock Text="AI-Конспект"
                               FontSize="28" FontWeight="Bold"
                               Foreground="White"/>
                    <TextBlock Text="Умный помощник для студентов"
                               FontSize="14" Foreground="#B0BEC5" Margin="0,4,0,0"/>
                </StackPanel>
            </materialDesign:ColorZone>

            <!-- Профили -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="24">
                <StackPanel>
                    <TextBlock Text="Выберите профиль"
                               FontSize="20" FontWeight="Medium"
                               Margin="0,0,0,16"
                               Foreground="{StaticResource PrimaryBrush}"/>

                    <!-- Сетка профилей -->
                    <ItemsControl ItemsSource="{Binding Profiles}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type models:StudentProfile}">
                                <materialDesign:Card Margin="8" Padding="0"
                                                     Width="160" Height="190"
                                                     Cursor="Hand">
                                    <materialDesign:Card.InputBindings>
                                        <MouseBinding MouseAction="LeftClick"
                                                      Command="{Binding DataContext.SelectProfileCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                      CommandParameter="{Binding}"/>
                                    </materialDesign:Card.InputBindings>
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <!-- Аватар -->
                                        <Border Grid.Row="0" CornerRadius="4,4,0,0">
                                            <Border.Background>
                                                <SolidColorBrush Color="{Binding AvatarColor}"/>
                                            </Border.Background>
                                            <TextBlock Text="{Binding AvatarInitials}"
                                                       FontSize="48" FontWeight="Bold"
                                                       Foreground="White"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>
                                        </Border>

                                        <!-- Имя и дата -->
                                        <StackPanel Grid.Row="1" Margin="12,8">
                                            <TextBlock Text="{Binding Name}"
                                                       FontSize="14" FontWeight="Medium"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding CreatedAt, StringFormat=dd.MM.yyyy}"
                                                       FontSize="11"
                                                       Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                                        </StackPanel>

                                        <!-- Кнопка удаления -->
                                        <Button Grid.Row="0"
                                                Style="{StaticResource MaterialDesignIconButton}"
                                                Command="{Binding DataContext.DeleteProfileCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}"
                                                HorizontalAlignment="Right" VerticalAlignment="Top"
                                                Margin="0,4,4,0"
                                                Width="28" Height="28"
                                                Foreground="White" Opacity="0.7">
                                            <materialDesign:PackIcon Kind="Close" Width="16" Height="16"/>
                                        </Button>
                                    </Grid>
                                </materialDesign:Card>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>

            <!-- Создание нового профиля -->
            <materialDesign:Card Grid.Row="2" Margin="24,0,24,24" Padding="20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBox Grid.Column="0"
                             materialDesign:HintAssist.Hint="Имя нового студента..."
                             materialDesign:HintAssist.IsFloating="True"
                             Text="{Binding NewProfileName, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,0,12,0">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Return" Command="{Binding CreateProfileCommand}"/>
                        </TextBox.InputBindings>
                    </TextBox>

                    <Button Grid.Column="1"
                            Command="{Binding CreateProfileCommand}"
                            Style="{StaticResource MaterialDesignRaisedButton}"
                            Background="{StaticResource PrimaryBrush}"
                            Content="Создать профиль"
                            Height="48"/>
                </Grid>
            </materialDesign:Card>
        </Grid>

        <!-- ════════════════════════════════════════════
             ГЛАВНЫЙ ЭКРАН (после выбора профиля)
             ════════════════════════════════════════════ -->
        <Grid Visibility="{Binding IsMainViewVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <!-- Топбар -->
                <RowDefinition Height="*"/>
                <!-- Контент -->
                <RowDefinition Height="Auto"/>
                <!-- Статус -->
            </Grid.RowDefinitions>

            <!-- ── Топбар ── -->
            <materialDesign:ColorZone Mode="PrimaryMid" Padding="20,14" Grid.Row="0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <materialDesign:PackIcon Kind="School" Width="28" Height="28"
                                                 Foreground="White" Margin="0,0,10,0"/>
                        <TextBlock Text="AI-Конспект" FontSize="20" FontWeight="Bold" Foreground="White"/>
                    </StackPanel>

                    <!-- Профиль текущего пользователя -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="36" Height="36" CornerRadius="18" Margin="0,0,10,0">
                            <Border.Background>
                                <SolidColorBrush Color="{Binding CurrentProfile.AvatarColor}"/>
                            </Border.Background>
                            <TextBlock Text="{Binding CurrentProfile.AvatarInitials}"
                                       FontWeight="Bold" Foreground="White"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="{Binding CurrentProfile.Name}"
                                   Foreground="White" FontSize="14" VerticalAlignment="Center"
                                   Margin="0,0,16,0"/>
                        <Button Style="{StaticResource MaterialDesignOutlinedButton}"
                                Foreground="White" BorderBrush="White"
                                Command="{Binding SwitchProfileCommand}"
                                Content="Сменить" Height="32" FontSize="12"/>
                    </StackPanel>
                </Grid>
            </materialDesign:ColorZone>

            <!-- ── Основной контент ── -->
            <Grid Grid.Row="1" Margin="20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="320"/>
                </Grid.ColumnDefinitions>

                <!-- Левая панель — ввод и настройки -->
                <StackPanel Grid.Column="0" Margin="0,0,16,0">

                    <!-- Режим работы -->
                    <materialDesign:Card Padding="20" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="Режим обработки"
                                       FontSize="14" FontWeight="Medium"
                                       Margin="0,0,0,12"
                                       Foreground="{StaticResource PrimaryBrush}"/>
                            <WrapPanel>
                                <RadioButton Content="📄  Краткий конспект"
                                             IsChecked="{Binding IsSummaryMode}"
                                             Style="{StaticResource MaterialDesignRadioButton}"
                                             Margin="0,0,20,0"/>
                                <RadioButton Content="📋  Отчёт"
                                             IsChecked="{Binding IsReportMode}"
                                             Style="{StaticResource MaterialDesignRadioButton}"
                                             Margin="0,0,20,0"/>
                                <RadioButton Content="🔬  Лабораторная работа"
                                             IsChecked="{Binding IsLabMode}"
                                             Style="{StaticResource MaterialDesignRadioButton}"/>
                            </WrapPanel>
                        </StackPanel>
                    </materialDesign:Card>

                    <!-- Источник данных -->
                    <materialDesign:Card Padding="20" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="Источник материала"
                                       FontSize="14" FontWeight="Medium"
                                       Margin="0,0,0,12"
                                       Foreground="{StaticResource PrimaryBrush}"/>

                            <!-- Переключатель источника -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                <RadioButton Content="Файл"
                                             IsChecked="{Binding IsFileInput}"
                                             Style="{StaticResource MaterialDesignRadioButton}"
                                             Margin="0,0,20,0"/>
                                <RadioButton Content="Ввод текста вручную"
                                             IsChecked="{Binding IsTextInput}"
                                             Style="{StaticResource MaterialDesignRadioButton}"/>
                            </StackPanel>

                            <!-- Загрузка файла -->
                            <Grid Visibility="{Binding IsFileInput, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Зона перетаскивания -->
                                <Border Grid.Row="0"
                                        BorderBrush="{StaticResource PrimaryBrush}"
                                        BorderThickness="2"
                                        CornerRadius="8"
                                        Background="#F3E5F5"
                                        Padding="20"
                                        Cursor="Hand"
                                        MinHeight="120"
                                        Margin="0,0,0,12">
                                    <Border.InputBindings>
                                        <MouseBinding MouseAction="LeftClick"
                                                      Command="{Binding LoadFileCommand}"/>
                                    </Border.InputBindings>
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <materialDesign:PackIcon Kind="CloudUpload"
                                                                 Width="40" Height="40"
                                                                 Foreground="{StaticResource PrimaryBrush}"
                                                                 HorizontalAlignment="Center"/>
                                        <TextBlock Text="Нажмите для выбора файла"
                                                   FontSize="14" FontWeight="Medium"
                                                   HorizontalAlignment="Center"
                                                   Margin="0,8,0,4"
                                                   Foreground="{StaticResource PrimaryBrush}"/>
                                        <TextBlock Text="PDF, Word (.docx), Excel (.xlsx), Markdown (.md), TXT"
                                                   FontSize="11"
                                                   HorizontalAlignment="Center"
                                                   Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                                    </StackPanel>
                                </Border>

                                <!-- Загруженный файл -->
                                <Grid Grid.Row="1"
                                      Visibility="{Binding LoadedFileName, Converter={StaticResource NullableToVisibilityConverter}}">
                                    <materialDesign:Card Background="#E8F5E9" Padding="12">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <materialDesign:PackIcon Grid.Column="0"
                                                                     Kind="FileDocument"
                                                                     Width="24" Height="24"
                                                                     Foreground="#388E3C"
                                                                     VerticalAlignment="Center"
                                                                     Margin="0,0,10,0"/>
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding LoadedFileName}"
                                                       VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis"
                                                       Foreground="#388E3C" FontWeight="Medium"/>
                                            <Button Grid.Column="2"
                                                    Style="{StaticResource MaterialDesignIconButton}"
                                                    Command="{Binding ClearFileCommand}"
                                                    Width="28" Height="28">
                                                <materialDesign:PackIcon Kind="Close" Width="16" Height="16"/>
                                            </Button>
                                        </Grid>
                                    </materialDesign:Card>
                                </Grid>
                            </Grid>

                            <!-- Ручной ввод -->
                            <TextBox Visibility="{Binding IsTextInput, Converter={StaticResource BooleanToVisibilityConverter}}"
                                     Text="{Binding ManualText, UpdateSourceTrigger=PropertyChanged}"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     MinHeight="150" MaxHeight="250"
                                     VerticalScrollBarVisibility="Auto"
                                     
                                     materialDesign:HintAssist.Hint="Вставьте или введите текст лекции..."
                                     materialDesign:HintAssist.IsFloating="True"/>
                        </StackPanel>
                    </materialDesign:Card>

                    <!-- Кнопка генерации -->
                    <Button Command="{Binding GenerateCommand}"
                            Style="{StaticResource MaterialDesignRaisedButton}"
                            Background="{StaticResource PrimaryBrush}"
                            Height="52" FontSize="16"
                            IsEnabled="{Binding IsProcessing, Converter={StaticResource InverseBooleanConverter}}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Sparkles" Width="22" Height="22"
                                                     VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="Сгенерировать конспект" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- Индикатор загрузки -->
                    <materialDesign:Card Margin="0,16,0,0" Padding="16"
                                         Visibility="{Binding IsProcessing, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel>
                            <ProgressBar Style="{StaticResource MaterialDesignLinearProgressBar}"
                                         IsIndeterminate="True"
                                         Foreground="{StaticResource PrimaryBrush}"/>
                            <TextBlock Text="{Binding StatusMessage}"
                                       FontSize="13" Margin="0,8,0,0"
                                       Foreground="{DynamicResource MaterialDesignBodyLight}"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>
                    </materialDesign:Card>

                    <!-- Результат -->
                    <materialDesign:Card Margin="0,16,0,0" Padding="20"
                                         Visibility="{Binding HasResult, Converter={StaticResource BooleanToVisibilityConverter}}"
                                         Background="#E8F5E9">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <materialDesign:PackIcon Kind="CheckCircle" Width="24" Height="24"
                                                         Foreground="#388E3C" Margin="0,0,8,0"/>
                                <TextBlock Text="Документ готов!"
                                           FontSize="16" FontWeight="Medium"
                                           Foreground="#388E3C" VerticalAlignment="Center"/>
                            </StackPanel>

                            <TextBlock Text="{Binding LastResult.Title}"
                                       FontSize="14" FontWeight="Medium"
                                       Margin="0,0,0,4"
                                       TextTrimming="CharacterEllipsis"/>

                            <WrapPanel Margin="0,8,0,0">
                                <Button Style="{StaticResource MaterialDesignRaisedButton}"
                                        Background="#388E3C"
                                        Command="{Binding OpenResultCommand}"
                                        Margin="0,0,8,0" Height="36">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="FileWord" Width="18" Height="18"
                                                                 Margin="0,0,6,0"/>
                                        <TextBlock Text="Открыть Word"/>
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource MaterialDesignOutlinedButton}"
                                        Command="{Binding OpenOutputFolderCommand}"
                                        Height="36">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="FolderOpen" Width="18" Height="18"
                                                                 Margin="0,0,6,0"/>
                                        <TextBlock Text="Открыть папку"/>
                                    </StackPanel>
                                </Button>
                            </WrapPanel>
                        </StackPanel>
                    </materialDesign:Card>
                </StackPanel>

                <!-- Правая панель — история -->
                <materialDesign:Card Grid.Column="1" Padding="0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Background="{StaticResource PrimaryBrush}" Padding="16,12">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="History" Width="20" Height="20"
                                                         Foreground="White" Margin="0,0,8,0"/>
                                <TextBlock Text="История"
                                           FontSize="15" FontWeight="Medium"
                                           Foreground="White" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding CurrentProfile.History}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type models:ConspectHistory}">
                                        <Border BorderBrush="#EEEEEE" BorderThickness="0,0,0,1"
                                                Padding="16,12" Cursor="Hand">
                                            <Border.InputBindings>
                                                <MouseBinding MouseAction="LeftClick"
                                                              Command="{Binding DataContext.OpenHistoryFileCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                              CommandParameter="{Binding}"/>
                                            </Border.InputBindings>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <materialDesign:PackIcon Kind="FileWord"
                                                                         Width="28" Height="28"
                                                                         Foreground="#6200EE"
                                                                         VerticalAlignment="Top"
                                                                         Margin="0,2,10,0"/>
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="{Binding Title}"
                                                               FontWeight="Medium" FontSize="13"
                                                               TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding SourceFileName}"
                                                               FontSize="11"
                                                               Foreground="{DynamicResource MaterialDesignBodyLight}"
                                                               TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding CreatedAt, StringFormat=dd.MM.yyyy HH:mm}"
                                                               FontSize="11"
                                                               Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <!-- Пустая история -->
                        <TextBlock Grid.Row="1"
                                   Text="История пуста"
                                   FontSize="13"
                                   Foreground="{DynamicResource MaterialDesignBodyLight}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Visibility="{Binding CurrentProfile.History.Count, Converter={StaticResource CountToVisibilityConverter}}"/>
                    </Grid>
                </materialDesign:Card>
            </Grid>

            <!-- ── Строка статуса / уведомлений ── -->
            <materialDesign:Snackbar Grid.Row="2"
                                     x:Name="MainSnackbar"
                                     MessageQueue="{materialDesign:MessageQueue}"/>
        </Grid>

        <!-- ════════════════════════════════════════════
             ВСПЛЫВАЮЩЕЕ УВЕДОМЛЕНИЕ
             ════════════════════════════════════════════ -->
        <materialDesign:Card HorizontalAlignment="Right" VerticalAlignment="Bottom"
                             Margin="24" Padding="16,12"
                             MaxWidth="400"
                             Visibility="{Binding IsNotificationVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                             Panel.ZIndex="99">
            <materialDesign:Card.Style>
                <Style TargetType="materialDesign:Card">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsError}" Value="True">
                            <Setter Property="Background" Value="#FFEBEE"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsError}" Value="False">
                            <Setter Property="Background" Value="#E8F5E9"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </materialDesign:Card.Style>
            <StackPanel Orientation="Horizontal">
                <materialDesign:PackIcon Width="20" Height="20" Margin="0,0,10,0">
                    <materialDesign:PackIcon.Style>
                        <Style TargetType="materialDesign:PackIcon">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsError}" Value="True">
                                    <Setter Property="Kind" Value="AlertCircle"/>
                                    <Setter Property="Foreground" Value="#B00020"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsError}" Value="False">
                                    <Setter Property="Kind" Value="CheckCircle"/>
                                    <Setter Property="Foreground" Value="#388E3C"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </materialDesign:PackIcon.Style>
                </materialDesign:PackIcon>
                <TextBlock Text="{Binding NotificationMessage}"
                           VerticalAlignment="Center" TextWrapping="Wrap"
                           MaxWidth="340"/>
            </StackPanel>
        </materialDesign:Card>
    </Grid>
</Window>
